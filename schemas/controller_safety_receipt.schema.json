{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seameinit.local/schemas/controller_safety_receipt.schema.json",
  "title": "SeaMeInIt ControllerSafetyReceipt",
  "type": "object",
  "required": ["schema_version","adaptive_module_receipt_hash","controller_artifact_hash","safety_envelope_hash","scenario_manifest_hash","controller_test_evidence_hash","scenario_count","hard_violation_count","max_command_latency_ms","command_latency_threshold_ms","emergency_stop_test_count","emergency_stop_failure_count","promotion","promotion_state","blocked_consumers","blocker_log","claim_boundary"],
  "properties": {
    "schema_version": {"const": "smii.controller_safety_receipt.v1"},
    "adaptive_module_receipt_hash": {"type": "string", "minLength": 1},
    "controller_artifact_hash": {"type": "string", "minLength": 1},
    "safety_envelope_hash": {"type": "string", "minLength": 1},
    "scenario_manifest_hash": {"type": "string", "minLength": 1},
    "controller_test_evidence_hash": {"type": "string", "minLength": 1},
    "scenario_count": {"type": "integer", "minimum": 0},
    "hard_violation_count": {"type": "integer", "minimum": 0},
    "max_command_latency_ms": {"type": "number", "minimum": 0},
    "command_latency_threshold_ms": {"type": "number", "minimum": 0},
    "emergency_stop_test_count": {"type": "integer", "minimum": 0},
    "emergency_stop_failure_count": {"type": "integer", "minimum": 0},
    "promotion": {"enum": [-1,0,1]},
    "promotion_state": {"enum": ["rejected","diagnostic_only","promoted"]},
    "blocked_consumers": {"type": "array", "items": {"type": "string"}},
    "blocker_log": {"type": "array", "items": {"type": "string"}},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
