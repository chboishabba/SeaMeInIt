{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seameinit.local/schemas/operator_tree_backend_evaluation.schema.json",
  "title": "SeaMeInIt OperatorTreeBackendEvaluationReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "claim_boundary",
    "source_panel_unwrap_receipt_hash",
    "mesh_hash",
    "seam_edges_hash",
    "panel_id",
    "source_tree_id",
    "operators",
    "source_composition_mode",
    "source_tree_metrics_were_diagnostic",
    "operator_partitions",
    "refinement_steps",
    "final_face_partition",
    "final_connected_chart_count",
    "backend_competitions",
    "original_metrics",
    "measured_metrics",
    "metric_comparison",
    "existing_parent_acceptance",
    "operator_hard_gate_passes",
    "promotion",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "smii.operator_tree_backend_evaluation.v1"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "source_panel_unwrap_receipt_hash": {"type": "string", "minLength": 1},
    "mesh_hash": {"type": "string", "minLength": 1},
    "seam_edges_hash": {"type": "string", "minLength": 1},
    "panel_id": {"type": "string", "pattern": "^P[0-9]+$"},
    "source_tree_id": {"type": "string", "minLength": 1},
    "operators": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "source_composition_mode": {"type": "string"},
    "source_tree_metrics_were_diagnostic": {"type": "boolean"},
    "operator_partitions": {"type": "array", "minItems": 2},
    "refinement_steps": {"type": "array", "minItems": 2},
    "final_face_partition": {"type": "array", "minItems": 2},
    "final_connected_chart_count": {"type": "integer", "minimum": 2},
    "backend_competitions": {"type": "array", "minItems": 2},
    "original_metrics": {"type": "object"},
    "measured_metrics": {"type": "object"},
    "metric_comparison": {"type": "object"},
    "existing_parent_acceptance": {"type": "boolean"},
    "operator_hard_gate_passes": {"type": "boolean"},
    "promotion": {"enum": [0, 1]},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
